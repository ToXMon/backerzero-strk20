# Hosted prover contract status for the pinned upstream investigation.
# Verified 2026-08-23 by pulling the image by immutable digest and running it.
# Do not fill these values from guesses or tag-only registry observations.
PRIVACY_PROVER_CONTRACT_STATUS=AVAILABLE_REAL_PROOF_VERIFIED_SEPOLIA
PRIVACY_PROVER_IMAGE=ghcr.io/starkware-libs/starknet-privacy/transaction-prover:PRIVACY-0.14.3-RC.2
PRIVACY_PROVER_IMAGE_DIGEST=sha256:a2f71d7139069fa566c4f44bdd66b79cac992c0cbc20ddf0af3a3558c6cabd64
PRIVACY_PROVER_IMAGE_DIGEST_AMD64=sha256:a62e7764e034ea25d84d4a235f1f683f7c5f03f88f6646a744599171bf5ca58c
PRIVACY_PROVER_IMAGE_DIGEST_ARM64=sha256:9882d27692b420a9edae9b50bf8075103044230de0f83ee6bed3db19cace105f
PRIVACY_PROVER_VERSION=0.19.0-rc.2
PRIVACY_PROVER_SPEC_VERSION=0.10.3-rc.2
PRIVACY_PROVER_PORT=3000
PRIVACY_PROVER_HEALTH_CONTRACT=starknet_specVersion
PRIVACY_PROVER_REQUEST_CONTRACT=starknet_proveTransaction
# Proving requires starknet_getStorageProof from the configured RPC node.
# starknet-devnet answers JSON-RPC error 42 ("Devnet doesn't support storage
# proofs"), so real proofs need a storage-proof-capable Sepolia endpoint or
# Pathfinder v0.22.7. See docs/TECHNICAL_VERIFICATION.md §9.
PRIVACY_PROVER_REQUIRED_RPC_METHOD=starknet_getStorageProof
PRIVACY_PROVER_REQUIRED_NODE=pathfinder:v0.22.7
# The linux/amd64 binary uses AMD-only SSE4a instructions and SIGILLs (exit 132)
# on Intel hosts. The successful Sepolia run used the same source commit
# (e6b6fd2e9932909107833579e5b6efd6c75fa0af) built with
# CARGO_PROFILE_RELEASE_RUSTFLAGS="-C target-cpu=x86-64".
PRIVACY_PROVER_ISA_CONSTRAINT=amd64_requires_sse4a
PRIVACY_PROVER_NATIVE_BUILD=/tmp/sequencer-shallow/target/release/starknet_transaction_prover
